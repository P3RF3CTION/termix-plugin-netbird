{
  "id": "netbird",
  "name": "NetBird",
  "version": "1.0.0",
  "description": "Lists the peers of your NetBird network, adds them as hosts and checks whether your access policies let Termix reach their SSH port.",
  "author": {
    "name": "Maximilian Herz",
    "url": "https://github.com/P3RF3CTION"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/P3RF3CTION/termix-plugin-netbird",
  "docs": "https://github.com/P3RF3CTION/termix-plugin-netbird/tree/main/docs",
  "category": "Networking",
  "icon": "Network",
  "features": [
    "Lists NetBird peers with NetBird IP, DNS name, OS, groups and online state",
    "Adds a peer as a host through the host editor, in one click",
    "Checks per peer whether a NetBird policy lets the Termix server reach its SSH port",
    "Works with NetBird Cloud and self-hosted management servers",
    "Read only: no host, credential or SSH access, the token stays on the server"
  ],
  "env": [],
  "engine": {
    "termix": ">=26.10.0",
    "api": "^1.2"
  },
  "capabilities": ["network:outbound", "network:serve", "ui:surface"],
  "contributes": {
    "panels": [
      {
        "id": "netbird",
        "titleKey": "nav.netbird",
        "icon": "Network"
      }
    ],
    "permissions": [
      {
        "name": "peers.view",
        "titleKey": "permissions.peers.view.title",
        "descriptionKey": "permissions.peers.view.description",
        "defaultRoles": ["admin"]
      }
    ],
    "settings": {
      "admin": [
        {
          "key": "managementUrl",
          "type": "string",
          "labelKey": "settings.managementUrl.label",
          "descriptionKey": "settings.managementUrl.description",
          "placeholderKey": "settings.managementUrl.placeholder",
          "default": "",
          "group": "settings.group.api"
        },
        {
          "key": "apiToken",
          "type": "secret",
          "labelKey": "settings.apiToken.label",
          "descriptionKey": "settings.apiToken.description",
          "placeholderKey": "settings.apiToken.placeholder",
          "group": "settings.group.api"
        },
        {
          "key": "termixPeer",
          "type": "string",
          "labelKey": "settings.termixPeer.label",
          "descriptionKey": "settings.termixPeer.description",
          "placeholderKey": "settings.termixPeer.placeholder",
          "default": "",
          "group": "settings.group.check"
        },
        {
          "key": "sshPort",
          "type": "number",
          "labelKey": "settings.sshPort.label",
          "descriptionKey": "settings.sshPort.description",
          "default": 22,
          "min": 1,
          "max": 65535,
          "group": "settings.group.check"
        }
      ]
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
